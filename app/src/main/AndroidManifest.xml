<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The bridge is a LAN socket to the user's own desktop, so INTERNET is required and
      ACCESS_NETWORK_STATE backs the "you're on a different network than you paired on" diagnosis
      on the offline screen. Both are normal permissions: neither prompts the user.

      Deliberately absent: ACCESS_FINE_LOCATION. Naming the current Wi-Fi network would need it,
      and a location prompt on an app that otherwise asks for nothing is a bad trade for a network
      name — knowing *that* the network changed is what sends the user to check their Wi-Fi.
      See HANDOFF_REMOTE_MOBILE.md §6.1.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Asked for at the moment the scanner opens, never at launch. It is used to read one QR
      code off the user's own screen; frames are decoded and discarded, and nothing is stored
      or sent anywhere.

      android:required="false" so a device without a camera can still install the app - the
      camera is needed for the convenient path through pairing, not for the app to work.
    -->
    <!--
      Asked for the first time a notification would be shown, not at launch. It is a
      convenience: the app works fully without it, and a phone that never grants it
      simply has to be opened to see what happened.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Keeps the app's process alive while it is connected, so a long run's "this needs
      your answer" notification can arrive with the phone in a pocket. Android kills
      backgrounded processes without warning, and nothing here is cached to disk, so a
      kill loses the whole session rather than pausing it.

      The cost is an ongoing notification the user cannot dismiss, which is the point of
      the trade Android is offering. It is therefore only running while actually
      connected, and it says which machine rather than "Anodex is running".
    -->
    <!--
      Asked for, never assumed. The foreground service keeps the link alive so an
      approval can reach a phone in a pocket, and on manufacturers with aggressive
      battery management — Samsung notably — that service is killed anyway unless
      the app is exempt. Without it "notify me while I am away" is not a promise
      this app can keep.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      The app is sideloaded, so nothing else is going to update it. This lets it hand a
      downloaded APK to Android's own installer, which then shows its usual "update this
      app?" screen - the app cannot install anything silently and this permission does
      not let it.

      From Android 8 the user must also switch it on for this app specifically, in system
      settings. That is deliberate on Android's part and the app only ever sends them to
      the page; see Updater.canRequestInstall.

      The download it hands over is fetched from a fixed GitHub URL over HTTPS and is
      rejected unless it carries this app's own signing certificate.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Dictation, without a microphone permission of our own.

      The composer's mic hands off to the phone's own speech screen - the same one the
      keyboard's mic key opens - and gets text back. Anodex never records audio. This
      block only lets the app see whether such a screen exists (package visibility,
      Android 11+), so the button is not shown on a phone where tapping it would do
      nothing.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnodexMobile">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AnodexMobile"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hands one downloaded APK to the system installer. Exports a single cache
          subdirectory and nothing else: grantUriPermissions means the installer gets
          read access to the one file it is passed, for as long as it is handling it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!--
          specialUse, not connectedDevice or dataSync, and each rejection is for a
          reason.

          connectedDevice was the first attempt and it crashed the app on launch: from
          Android 14 it requires one of a set of prerequisite permissions - Bluetooth,
          NFC, USB, CHANGE_NETWORK_STATE - none of which this app has any business
          holding just to keep a socket alive.

          dataSync would be permitted, but Android 15 caps it at six hours a day and
          then stops it. This service exists precisely so a connection survives a long
          spell in a pocket, so a silent stop after six hours reintroduces the bug it
          was added to fix.

          What it actually does is hold a long-lived connection to a computer the user
          owns, which is what specialUse is for.
        -->
        <service
            android:name=".connection.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the connection to the user's own desktop Anodex alive so approvals and run notifications arrive while the app is in the background." />
        </service>
    </application>

</manifest>
