<?xml version="1.0" encoding="utf-8"?><!--
  A minimal platform theme. All real styling is Compose (ui/theme/Theme.kt); this exists only to
  own the window before the first frame is drawn, so launching the app doesn't flash a pale
  rectangle on the way into the UI.

  Dark regardless of the system setting, because dark is the app's default theme
  (DEFAULT_THEME_MODE). Someone who chose Light sees this for the instant before the first frame.

  The bars are transparent because MainActivity draws edge to edge; AnodexTheme sets the bar icon
  polarity once Compose is up.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AnodexMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>
