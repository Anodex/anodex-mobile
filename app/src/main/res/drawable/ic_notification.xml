<?xml version="1.0" encoding="utf-8"?><!--
  The status-bar icon.

  Android masks a notification icon to its alpha channel and tints it, so the
  gradient mark cannot be used here - it would arrive as a solid blob. This is the
  same "A" silhouette the themed launcher icon uses, drawn as a path so it stays
  crisp at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,3 L20.5,21 L16.8,21 L12,10.4 L9.6,15.7 L13.2,15.7 L14.8,19.1 L4,19.1 Z" />
</vector>
