<?xml version="1.0" encoding="utf-8"?>
<!--
  The bar: near-black glass inside a hairline of the mark's own violet-to-blue.

  The ring is a gradient shape with the surface inset 1dp over it, since a shape's
  stroke cannot be a gradient.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#994F8CFF"
                android:startColor="#997C5CFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#F2141418" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</layer-list>
