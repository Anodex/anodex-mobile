<?xml version="1.0" encoding="utf-8"?><!--
  The Anodex mark: a hexagon with the "A" inside it, carrying the logo's cyan → blue → violet
  ramp. Drawn inside the 108dp adaptive-icon viewport with everything kept within the 72dp safe
  zone, so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hexagon edge. Cool blue, as on the desktop logo. -->
    <path
        android:pathData="M54,24 L80,39 L80,69 L54,84 L28,69 L28,39 Z"
        android:strokeWidth="3.5"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="24"
                android:endX="80"
                android:endY="84"
                android:type="linear">
                <item android:color="#FF38BDF8" android:offset="0" />
                <item android:color="#FF4F8CFF" android:offset="0.5" />
                <item android:color="#FF7C5CFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The "A": two legs and a crossbar, stroked rather than filled so it stays crisp small. -->
    <path
        android:pathData="M43,70 L54,40 L65,70"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="43"
                android:startY="40"
                android:endX="65"
                android:endY="70"
                android:type="linear">
                <item android:color="#FF38BDF8" android:offset="0" />
                <item android:color="#FF7C5CFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M47.5,61 L60.5,61"
        android:strokeColor="#FF4F8CFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

</vector>
