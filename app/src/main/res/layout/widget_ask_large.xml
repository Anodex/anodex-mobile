<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget stretched taller: the same bar, and under it the conversations you
  used most recently, each one tap from being open.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <include
        layout="@layout/widget_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_panel_background"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:text="@string/widget_recent"
            android:textColor="#FF8A8A8A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_recent_1"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/widget_row_background"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFE6E6E6"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_recent_2"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/widget_row_background"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFE6E6E6"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_recent_3"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/widget_row_background"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFE6E6E6"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_recent_empty"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_recent_empty"
            android:textColor="#FF8A8A8A"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
