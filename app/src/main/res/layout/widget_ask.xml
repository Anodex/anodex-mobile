<?xml version="1.0" encoding="utf-8"?>
<!--
  The home screen widget: the Anodex mark, "Ask Anodex…" and a camera.

  RemoteViews, not Compose: a widget is drawn by the launcher, which only knows the
  platform's own views. Kept to the handful of view types every launcher back to
  Android 8 can render.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="6dp">

    <LinearLayout
        android:id="@+id/widget_ask"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/anodex_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_ask"
            android:textColor="#FF9A9A9A"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_camera"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="@string/widget_camera"
        android:padding="11dp"
        android:src="@drawable/ic_widget_camera" />
</LinearLayout>
