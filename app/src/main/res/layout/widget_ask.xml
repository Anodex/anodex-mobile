<?xml version="1.0" encoding="utf-8"?>
<!--
  The home screen widget at its usual one-row size: a slim bar centred in its cell
  rather than a slab filling it.

  RemoteViews, not Compose: a widget is drawn by the launcher, which only knows the
  platform's own views. Kept to the handful of view types every launcher back to
  Android 8 can render.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <include
        layout="@layout/widget_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical" />
</FrameLayout>
